# Copy to `.env` and fill in. NEVER commit the real file — it is gitignored.
# None of these values are ever sent to the browser.

NODE_ENV=development
PORT=3333

# SMTP provider (Postmark, Resend SMTP, SES, Fastmail, Gmail app password, …)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey-or-username
SMTP_PASSWORD=super-secret-value

# Where enquiries are delivered, and the authenticated identity they are sent from.
CONTACT_RECEIVER_EMAIL=you@example.com
CONTACT_SENDER_EMAIL=no-reply@yourdomain.com

# Comma-separated browser origins permitted to POST to this API.
ALLOWED_ORIGINS=http://localhost:4200,https://www.rabinr.in

# Per-IP submission limit.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=5

{
  "name": "rabin-portfolio",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "npm run site-url && npm run sitemap && ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr": "node dist/web/server/server.mjs",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\" \"server/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server start",
    "images": "node tools/optimize-screenshots.mjs",
    "verify:assets": "node tools/verify-assets.mjs",
    "site-url": "node tools/generate-site-url.mjs",
    "sitemap": "node tools/generate-sitemap.mjs",
    "compose:mobile": "node tools/compose-mobile-shots.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "http-proxy-middleware": "^4.2.0",
    "nodemailer": "^7.0.13",
    "rxjs": "~7.8.0",
    "three": "^0.185.1",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/nodemailer": "^6.4.24",
    "@types/three": "^0.185.4",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
